{
  "name": "twake-mail-side-service",
  "version": "0.5.0",
  "private": true,
  "description": "Gives each TwakeSpace space a TMail team mailbox, keeps its members in step with the space, and reports the mailbox's mail to the space feed",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check .",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/**/*.int.spec.ts'",
    "test:integration": "vitest run .int.spec",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@linagora/rabbitmq-client": "^0.7.1",
    "@linagora/twake-node-telemetry": "^1.1.0",
    "@sentry/node": "^10.75.3",
    "drizzle-orm": "^0.45.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.0.0",
    "@testcontainers/rabbitmq": "^11.0.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.0"
  }
}
